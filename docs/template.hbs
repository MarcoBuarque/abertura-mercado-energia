<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{title}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Unofficial, hand-written description of part of the retail APIs of the Brazilian energy market opening. Independent project." />
  <style>
    body { margin: 0; padding: 0; }
    .unofficial-banner {
      box-sizing: border-box;
      width: 100%;
      margin: 0;
      padding: 12px max(16px, env(safe-area-inset-right)) 12px max(16px, env(safe-area-inset-left));
      background: #fff1d6;
      color: #4a2f00;
      border-bottom: 2px solid #c98a1b;
      font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      overflow-wrap: anywhere;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .unofficial-banner .long { display: none; }
    .unofficial-banner strong { font-weight: 700; }
    .unofficial-banner a { color: inherit; text-decoration: underline; }
    @media (min-width: 640px) {
      .unofficial-banner { text-align: center; }
      .unofficial-banner .long { display: inline; }
    }
    @media (max-width: 639px) {
      .unofficial-banner { font-size: 14px; padding-top: 8px; padding-bottom: 8px; }
    }
  </style>
  {{{redocHead}}}
</head>
<body>
  <aside class="unofficial-banner" role="note" aria-label="Non-affiliation notice">
    <strong>Notice: unofficial description.</strong>
    Independent project, not affiliated with, sponsored or endorsed by the CCEE.
    <span class="long">The spec describes what the API returned in sandbox
    tests and does not replace the operator's documentation. Where the two
    differ, the file <code>openapi/SOURCES.md</code> explains why.</span>
  </aside>
  {{{redocHTML}}}
  <script>
    // The banner is pinned to the top; Redoc 3 accepts its height in --navbar-height
    // to position the side menu right below it.
    (function () {
      var banner = document.querySelector(".unofficial-banner");
      function apply() {
        var root = document.querySelector("#redoc > div[style*='navbar-height']");
        if (!root) { return false; }
        var h = banner.getBoundingClientRect().height + "px";
        root.style.setProperty("--navbar-height", h);
        root.style.setProperty("--navbar-stack-height", h);
        return true;
      }
      // React hydration may rewrite the style attribute: reapply
      // while the page loads and on every size change.
      var attempts = 0;
      var wait = setInterval(function () {
        apply();
        if (++attempts > 60) { clearInterval(wait); }
      }, 100);
      window.addEventListener("resize", apply);
      if (window.ResizeObserver) { new ResizeObserver(apply).observe(banner); }
    })();
  </script>
</body>
</html>
