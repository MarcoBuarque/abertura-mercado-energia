#!/usr/bin/env bash
# Pre-commit hook: gitleaks on the staged files.
# `make hooks` installs the pinned binary in out/bin.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

gl="${GITLEAKS:-$root/out/bin/gitleaks}"
if [ ! -x "$gl" ]; then
  echo "pre-commit: gitleaks not found at $gl. Run 'make hooks'." >&2
  exit 1
fi

if ! "$gl" git --staged --config "$root/.gitleaks.toml" --no-banner --redact --exit-code 42; then
  echo "pre-commit: possible secret in the staged files. Commit blocked." >&2
  exit 1
fi
